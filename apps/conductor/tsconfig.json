{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../..",
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../../tests/NOUS.CONDUCTOR.MERGE_GATES.1.test.ts",
    "../../tests/NOUS.CONDUCTOR.MERGE_GATES.2.test.ts",
    "../../tests/NOUS.CONDUCTOR.MERGE_GATES.3.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
