{
  "name": "macgruber",
  "version": "0.1.0",
  "private": true,
  "description": "Universal pipeline failure handler — LLM agent that receives, investigates, and remediates pipeline failures.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
