# MacGruber — Universal Pipeline Failure Handler
# Copy to .env and populate. NEVER commit a real .env.

# NOUS API key. Used to write events, friction, and decision queue rows.
NOUS_KEY=

# Anthropic API key. Used by claude-haiku (severity) and claude-sonnet (strategy).
ANTHROPIC_KEY=

# GitHub PAT with repo scope. Used to read commit / dispatch state for investigations.
GITHUB_TOKEN=

# Postgres connection string for the nous database. Schema: nous.
DATABASE_URL=

# HTTP port. Defaults to 8792 if unset.
PORT=8792
